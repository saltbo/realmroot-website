---
import '../styles/global.css';
import { copy, site, type Locale } from '../site';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath = Astro.url.pathname,
} = Astro.props;
const t = copy[locale];
const isChinese = locale === 'zh-CN';
const languageHref = isChinese
  ? canonicalPath.replace(/^\/zh-cn/, '') || '/'
  : `/zh-cn${canonicalPath === '/' ? '/' : canonicalPath}`;
const canonical = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f2ea" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isChinese ? 'en' : 'zh-CN'} href={languageHref} />
    <link rel="alternate" type="application/rss+xml" title="Realmroot Blog" href={isChinese ? '/zh-cn/rss.xml' : '/rss.xml'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={t.home} aria-label="Realmroot home">
          <span class="brand-tile" aria-hidden="true">R</span>
          <span>Realmroot</span>
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a href={`${t.home}#agents`}>{t.nav.agents}</a>
          <a href={`${t.home}#products`}>{t.nav.product}</a>
          <a href={`${t.home}#architecture`}>{t.nav.architecture}</a>
          <a href={site.wallet}>{t.nav.wallet}</a>
          <a href={isChinese ? '/zh-cn/docs/' : '/docs/'}>{t.nav.docs}</a>
          <a href={isChinese ? '/zh-cn/blog/' : '/blog/'}>{t.nav.blog}</a>
        </nav>
        <nav class="compact-nav" aria-label="Primary navigation">
          <a href={site.wallet}>{t.nav.wallet}</a>
          <a href={isChinese ? '/zh-cn/docs/' : '/docs/'}>{t.nav.docs}</a>
          <a href={isChinese ? '/zh-cn/blog/' : '/blog/'}>{t.nav.blog}</a>
        </nav>
        <div class="nav-actions">
          <a class="language-link" href={languageHref}>{isChinese ? 'EN' : '中文'}</a>
          <a class="button button-dark button-small" href={site.github}>{t.nav.github}</a>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <a class="brand footer-brand" href={t.home}>
            <span class="brand-tile" aria-hidden="true">R</span>
            <span>Realmroot</span>
          </a>
          <p>{t.footer.statement}</p>
        </div>
        <div>
          <strong>{t.footer.product}</strong>
          <a href={`${t.home}#products`}>Realmroot Identity</a>
          <a href={site.wallet}>Realmroot Wallet</a>
          <a href={`${t.home}#architecture`}>{t.nav.architecture}</a>
        </div>
        <div>
          <strong>{t.footer.resources}</strong>
          <a href={isChinese ? '/zh-cn/blog/' : '/blog/'}>{t.nav.blog}</a>
          <a href={isChinese ? '/zh-cn/docs/' : '/docs/'}>{t.nav.docs}</a>
          <a href={site.github}>GitHub</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Realmroot</span>
        <span>{t.footer.legal}</span>
      </div>
    </footer>
  </body>
</html>
