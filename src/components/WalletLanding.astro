---
import { site, type Locale } from '../site';
import PhraseText from './PhraseText.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh-CN';
const t = zh
  ? {
      eyebrow: 'OIDC-native Agent 支付',
      title: ['给 Agent 预算。', '把密钥留给用户。'],
      lead: '一个属于用户的钱包，为每个 Agent 设置明确、可撤销的支付边界。通过 Base 上的标准 x402 完成支付。',
      primary: '打开 Wallet',
      secondary: '进入 Sandbox',
      trust: ['不向 Agent 暴露私钥', '每次支付验证 DPoP', '独立 Agent 预算'],
      preview: {
        balance: '可用余额',
        protected: 'Base Mainnet · 受保护',
        policy: '有效支付策略',
        spent: '已使用',
        budget: '预算',
        settled: '刚刚结算',
      },
      controlsEyebrow: 'Spending controls',
      controlsTitle: ['每个 Agent，', '自己的支付边界。'],
      controlsBody: '身份建立之后，支付权限仍然需要单独决定。所有限制都会在每次签名前重新检查。',
      controls: [
        ['01', '精确预算', '分别设置总额、单笔、每日与每月 USDC 限额，并为授权设置明确到期时间。'],
        ['02', '明确对象', '可限定商户 Origin、收款地址与允许支付的资产，避免预算被挪作其他用途。'],
        ['03', '随时停止', '暂停一个 Agent，或立即冻结所有 Agent 支付。策略变更无需轮换钱包。'],
      ],
      flowEyebrow: 'x402 payment flow',
      flowTitle: ['Agent 完成支付。', 'Wallet 守住边界。'],
      flow: [
        ['请求', '业务 API 返回 PAYMENT-REQUIRED。'],
        ['授权', 'Agent 提交支付要求与稳定的幂等键。'],
        ['签名', 'Wallet 校验身份、DPoP 与预算后请求 CDP 签名。'],
        ['结算', 'Agent 重试业务请求，Wallet 验证链上 USDC 转账。'],
      ],
      securityEyebrow: 'Trust boundary',
      securityTitle: 'Agent 永远拿不到钱包密钥。',
      securityBody: 'CDP 持有签名能力。Wallet 只接受短期、DPoP 绑定的 Agent Token，并在签名前执行控制者定义的支付策略。',
      securityFacts: [
        ['Identity', '任何兼容的 OIDC Provider；Realmroot 可选'],
        ['Signing', 'CDP delegated signing，不导出用户私钥'],
        ['Network', 'Base Mainnet；Sandbox 使用 Base Sepolia'],
        ['Recovery', '幂等授权、结算验证与完整支付审计'],
      ],
      finalTitle: '让 Agent 支付，而不是持有你的钱包。',
      finalBody: '从 Sandbox 开始，为第一个 Agent 配置一条可撤销的 USDC 支付策略。',
    }
  : {
      eyebrow: 'OIDC-native Agent payments',
      title: ['Give Agents a budget.', 'Keep the keys.'],
      lead: 'One wallet owned by the user. Explicit, revocable spending boundaries for every Agent. Standard x402 payments on Base.',
      primary: 'Open Wallet',
      secondary: 'Explore Sandbox',
      trust: ['No private keys exposed', 'DPoP on every payment', 'Per-Agent budgets'],
      preview: {
        balance: 'Available balance',
        protected: 'Base Mainnet · Protected',
        policy: 'Active spending policy',
        spent: 'Spent',
        budget: 'Budget',
        settled: 'Settled just now',
      },
      controlsEyebrow: 'Spending controls',
      controlsTitle: ['Every Agent.', 'Its own payment boundary.'],
      controlsBody: 'Identity does not imply spending authority. Every restriction is checked again before every signature.',
      controls: [
        ['01', 'Exact budgets', 'Set total, per-payment, daily, and monthly USDC limits with an explicit expiration time.'],
        ['02', 'Named destinations', 'Allow only approved merchant origins, recipient addresses, and payment assets.'],
        ['03', 'Immediate control', 'Pause one Agent or freeze every Agent payment without rotating the user wallet.'],
      ],
      flowEyebrow: 'x402 payment flow',
      flowTitle: ['The Agent pays.', 'The Wallet holds the boundary.'],
      flow: [
        ['Request', 'The business API returns PAYMENT-REQUIRED.'],
        ['Authorize', 'The Agent forwards the requirement with a stable idempotency key.'],
        ['Sign', 'Wallet checks identity, DPoP, and policy before asking CDP to sign.'],
        ['Settle', 'The Agent retries the request and Wallet verifies the USDC transfer.'],
      ],
      securityEyebrow: 'Trust boundary',
      securityTitle: 'The Agent never receives a wallet key.',
      securityBody: 'CDP holds signing authority. Wallet accepts short-lived, DPoP-bound Agent tokens and applies controller-defined policy before every signature.',
      securityFacts: [
        ['Identity', 'Any compatible OIDC provider; Realmroot is optional'],
        ['Signing', 'CDP delegated signing with no private-key export'],
        ['Network', 'Base Mainnet; Base Sepolia in Sandbox'],
        ['Recovery', 'Idempotent authorization, settlement checks, full audit'],
      ],
      finalTitle: 'Let Agents pay without holding your wallet.',
      finalBody: 'Start in Sandbox and give your first Agent a revocable USDC spending policy.',
    };
---

<section class="wallet-stage" id="wallet">
  <div class="section-shell">
    <div class="wallet-stage-bar">
      <div><strong>Wallet</strong><span>Agent payment control</span></div>
      <span><i></i>{zh ? '系统正常' : 'All systems operational'}</span>
    </div>

    <div class="wallet-stage-intro">
      <div>
        <p class="eyebrow light"><span></span>{t.eyebrow}</p>
        <h1 class="heading-lines">{t.title.map((line) => <span>{line}</span>)}</h1>
      </div>
      <div class="wallet-stage-brief">
        <p><PhraseText locale={locale} text={t.lead} /></p>
        <div class="hero-actions">
          <a class="button button-inverted" href={site.wallet}>{t.primary}<span aria-hidden="true">↗</span></a>
          <a class="button button-ghost-light" href={`${site.wallet}/sandbox`}>{t.secondary}</a>
        </div>
      </div>
    </div>

    <div class="wallet-console" aria-label={zh ? 'Wallet 产品控制台预览' : 'Wallet product control console'}>
      <div class="wallet-console-head">
        <span><i></i>LIVE / BASE MAINNET</span>
        <span>wallet.realmroot.dev</span>
        <span>UTC 14:32:08</span>
      </div>
      <div class="wallet-console-grid">
        <section class="wallet-balance-panel">
          <small>{zh ? '用户钱包' : 'OWNER WALLET'}</small>
          <p>{t.preview.balance}</p>
          <strong>2,480.00</strong>
          <span>USDC</span>
          <div class="wallet-ring" aria-label={zh ? '本月预算已使用 23%' : '23% of monthly budget used'}>
            <i></i><span>23%</span>
          </div>
          <dl>
            <div><dt>{zh ? '本月已用' : 'MONTH SPEND'}</dt><dd>$182.40</dd></div>
            <div><dt>{zh ? '可用预算' : 'AVAILABLE'}</dt><dd>$612.60</dd></div>
          </dl>
        </section>

        <section class="wallet-agent-panel">
          <header><span>{zh ? 'Agent 策略' : 'AGENT POLICIES'}</span><strong>03 ACTIVE</strong></header>
          <div class="wallet-agent-row featured">
            <span>RA</span>
            <div><strong>Research Agent</strong><small>api.weather.dev · x402</small></div>
            <div><small>{zh ? '每日限额' : 'DAILY LIMIT'}</small><strong>$100</strong></div>
          </div>
          <div class="wallet-agent-row">
            <span>CA</span>
            <div><strong>Commerce Agent</strong><small>2 {zh ? '个允许商户' : 'allowed merchants'}</small></div>
            <div><small>{zh ? '每日限额' : 'DAILY LIMIT'}</small><strong>$250</strong></div>
          </div>
          <div class="wallet-agent-row">
            <span>DA</span>
            <div><strong>Data Agent</strong><small>{zh ? '仅 Sandbox' : 'Sandbox only'}</small></div>
            <div><small>{zh ? '每日限额' : 'DAILY LIMIT'}</small><strong>$25</strong></div>
          </div>
        </section>

        <section class="wallet-stream-panel">
          <header><span>{zh ? '支付事件流' : 'PAYMENT STREAM'}</span><strong>LIVE</strong></header>
          <div><time>14:32:08</time><i class="settled"></i><p><strong>$0.025</strong><span>api.weather.dev</span></p><small>SETTLED</small></div>
          <div><time>14:31:52</time><i class="authorized"></i><p><strong>$1.20</strong><span>maps.example</span></p><small>AUTHORIZED</small></div>
          <div><time>14:30:17</time><i class="blocked"></i><p><strong>$84.00</strong><span>unknown origin</span></p><small>BLOCKED</small></div>
          <div><time>14:28:44</time><i class="settled"></i><p><strong>$0.008</strong><span>data.market.dev</span></p><small>SETTLED</small></div>
        </section>
      </div>
      <div class="wallet-console-foot">
        {t.trust.map((item) => <span><i></i>{item}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="wallet-policy-section section" id="controls">
  <div class="section-shell wallet-policy-layout">
    <div class="wallet-policy-intro">
      <p class="eyebrow"><span></span>{t.controlsEyebrow}</p>
      <h2 class="heading-lines">{t.controlsTitle.map((line) => <span>{line}</span>)}</h2>
      <p><PhraseText locale={locale} text={t.controlsBody} /></p>
    </div>
    <div class="wallet-policy-list">
      {t.controls.map(([number, title, body], index) => (
        <article>
          <span>{number}</span>
          <div>
            <h3>{title}</h3>
            <p><PhraseText locale={locale} text={body} /></p>
          </div>
          <small>{index === 0 ? 'USDC / TIME' : index === 1 ? 'ORIGIN / TO' : 'PAUSE / FREEZE'}</small>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="wallet-protocol" id="flow">
  <div class="section-shell">
    <div class="wallet-protocol-head">
      <div>
        <p class="eyebrow light"><span></span>{t.flowEyebrow}</p>
        <h2 class="heading-lines">{t.flowTitle.map((line) => <span>{line}</span>)}</h2>
      </div>
      <p>{zh ? '一次支付授权，一条完整证据链。' : 'One payment authorization. One complete evidence trail.'}</p>
    </div>
    <div class="wallet-protocol-track">
      <div class="wallet-protocol-origin">
        <small>RESOURCE SERVER</small>
        <strong>HTTP 402</strong>
        <code>PAYMENT-REQUIRED</code>
      </div>
      <div class="wallet-protocol-events">
        {t.flow.map(([title, body], index) => (
          <article>
            <span>0{index + 1}</span>
            <div><h3>{title}</h3><p><PhraseText locale={locale} text={body} /></p></div>
          </article>
        ))}
      </div>
      <div class="wallet-protocol-result">
        <small>SETTLEMENT</small>
        <strong>200 OK</strong>
        <code>PAYMENT-RESPONSE</code>
      </div>
    </div>
  </div>
</section>

<section class="wallet-boundary section">
  <div class="section-shell">
    <div class="wallet-boundary-statement">
      <p class="eyebrow"><span></span>{t.securityEyebrow}</p>
      <h2>{t.securityTitle}</h2>
      <p><PhraseText locale={locale} text={t.securityBody} /></p>
    </div>
    <dl class="wallet-boundary-ledger">
      {t.securityFacts.map(([term, description], index) => (
        <div>
          <span>0{index + 1}</span>
          <dt>{term}</dt>
          <dd><PhraseText locale={locale} text={description} /></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="wallet-launch">
  <div class="section-shell wallet-launch-inner">
    <div>
      <p>OIDC · DPoP · x402 · USDC</p>
      <h2>{t.finalTitle}</h2>
    </div>
    <div>
      <p><PhraseText locale={locale} text={t.finalBody} /></p>
      <a class="button button-dark" href={`${site.wallet}/sandbox`}>{t.secondary}<span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
