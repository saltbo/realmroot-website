---
import { getCollection } from 'astro:content';
import { site, type Locale } from '../site';
import PhraseText from './PhraseText.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh-CN';
const docsHref = zh ? '/zh-cn/docs/' : '/docs/';
const posts = (await getCollection('blog'))
  .filter((post) => post.data.language === locale)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const t = zh
  ? {
      eyebrow: '面向 AI Agent 的身份与委托授权',
      title: ['Agent 需要身份。', '不是借来的凭据。'],
      lead: '为每个 Agent 建立持久身份，并让控制者只批准它需要的 API、Scope 与授权期限。',
      primary: '了解工作方式',
      secondary: '阅读文档',
      facts: ['跨宿主保持稳定', '精确 Scope', '短期令牌', '随时可撤销'],
      passport: {
        label: 'Agent Passport / Authority Flow',
        hosts: '宿主凭据',
        hostNames: ['Laptop Key', 'Worker Key', 'Sandbox Key'],
        identity: '持久 Agent 身份',
        name: 'Research Agent',
        issuer: 'Issuer',
        issuerValue: 'Realmroot',
        subject: 'Subject',
        subjectValue: '跨宿主不可变',
        verified: '一个身份，多个可替换宿主密钥',
        request: '显式授权申请',
        status: '等待批准',
        resource: 'Resource',
        scope: 'Exact scope',
        lifetime: 'Lifetime',
      },
      authorityTitle: ['让 Agent 行动。', '让权限始终明确。'],
      authorityNote: '不冒充用户。不下发 Refresh Token。不代理业务 API。',
      flow: [
        ['身份', '为 Agent 签发不依赖当前宿主的持久 Subject。'],
        ['申请', 'Agent 请求指定 Resource、Scope 与期限。'],
        ['批准', '控制者只授予任务真正需要的权限。'],
        ['访问', 'Agent 使用短期 DPoP 令牌直连 API。'],
      ],
      distinctionEyebrow: '为什么是 Realmroot',
      distinctionTitle: ['Agent 是主体。', '权限是核心。'],
      distinctionBody: 'Realmroot 把 Agent 作为独立安全主体建模，同时保留人类控制者的最终授权权力。',
      distinctions: [
        {
          number: '01',
          title: '身份独立于宿主。',
          body: 'Agent 的 Issuer 与 Subject 保持稳定。宿主密钥可以轮换、撤销或迁移，而不会创建新的公共身份。',
          proof: 'Stable identity ≠ host credential',
        },
        {
          number: '02',
          title: '登记不授予权限。',
          body: '建立身份不会自动获得业务访问。更换 Resource、Account 或扩大 Scope，都需要控制者重新决定。',
          proof: 'Identity first. Authority on request.',
        },
        {
          number: '03',
          title: '授权不进入数据路径。',
          body: '批准后，Agent 使用 Audience 限定、DPoP 绑定的短期令牌直接调用原生或外部 API。',
          proof: 'Agent → API, directly',
        },
      ],
      grantEyebrow: 'Explicit authority',
      grantTitle: ['每一次批准，', '都有明确边界。'],
      grantBody: '每个 Grant 都绑定一个 Agent、一个 Resource、精确 Scope 与明确期限。审计记录可以还原谁批准了什么，而不会记录凭据或原始 Token。',
      ledger: {
        title: 'Access request',
        agent: 'Agent principal',
        controller: 'Controller',
        resource: 'Customer Support API',
        scopes: ['tickets:read', 'drafts:write'],
        lifetime: 'Limited · 30 min',
        approved: 'Controller approved',
        issued: 'Short-lived token issued',
      },
      realmEyebrow: 'One realm, every actor',
      realmTitle: ['Agent-first，', '服务每一种身份。'],
      realmBody: '用户、应用、API 和 Agent 共享同一个 Issuer 与策略边界。产品不再拼装独立的登录系统、Agent 密钥仓库和授权代理。',
      realmActors: [
        ['People', 'Hosted sign-in, MFA, passkeys, sessions'],
        ['Applications', 'OIDC clients and product integrations'],
        ['Agents', 'Durable identity and delegated authority'],
        ['APIs', 'Native or external protected resources'],
      ],
      boundary: ['一个部署', '一个用户池', '一个 Issuer', '一个策略边界'],
      standardsTitle: '使用开放标准，而不是专有 Agent 隧道。',
      standards: ['OpenID Connect', 'OAuth 2.0', 'RFC 8693', 'DPoP', 'OpenAPI'],
      productsEyebrow: 'Realmroot products',
      productsTitle: ['身份决定谁在行动。', '钱包约束它如何支付。'],
      productsBody: '两个产品都可独立使用，也可组合成覆盖 Agent 身份、授权与支付的完整信任链。',
      identityProduct: {
        label: '01 / Realmroot Identity',
        title: '持久身份与显式权限',
        body: '为用户、应用、API 和 Agent 提供一个 Issuer 与策略边界。Agent 使用短期、DPoP 绑定的令牌直接访问目标 API。',
        points: ['持久 Agent Subject', '精确 Scope 与期限', '标准 OIDC / OAuth'],
        cta: '阅读 Identity 文档',
      },
      walletProduct: {
        label: '02 / Realmroot Wallet',
        title: '给 Agent 预算，而不是密钥',
        body: 'OIDC-native 的 x402 Wallet SaaS。用户保留钱包控制权，每个 Agent 只在明确、可撤销的支付策略内行动。',
        points: ['总额、单笔、日/月 USDC 限额', '商户与收款地址白名单', '暂停、撤销与支付审计'],
        cta: '打开 Wallet',
      },
      blogEyebrow: 'Journal',
      blogTitle: ['Agent 身份与显式权限'],
      allPosts: '查看全部文章',
      read: '阅读',
      finalTitle: ['给每个 Agent 一个真正的身份。'],
      finalBody: '运行一个 Realm，为人、应用、API 与 Agent 建立清晰的信任根。',
      deploy: '部署 Realmroot',
      walletCta: '打开 Wallet',
    }
  : {
      eyebrow: 'Identity and delegated access for AI agents',
      title: ['Agents need identity.', 'Not borrowed credentials.'],
      lead: 'Give every Agent a durable identity and controller-approved access to the exact APIs, scopes, and lifetime it needs.',
      primary: 'See how it works',
      secondary: 'Read the docs',
      facts: ['Stable across hosts', 'Exact scopes', 'Short-lived tokens', 'Revocable by design'],
      passport: {
        label: 'Agent Passport / Authority Flow',
        hosts: 'Host credentials',
        hostNames: ['Laptop key', 'Worker key', 'Sandbox key'],
        identity: 'Durable Agent identity',
        name: 'Research Agent',
        issuer: 'Issuer',
        issuerValue: 'Realmroot',
        subject: 'Subject',
        subjectValue: 'Immutable across hosts',
        verified: 'One identity, many replaceable host keys',
        request: 'Explicit authority request',
        status: 'Awaiting approval',
        resource: 'Resource',
        scope: 'Exact scope',
        lifetime: 'Lifetime',
      },
      authorityTitle: ['Let agents act.', 'Explicit authority.'],
      authorityNote: 'No impersonation. No refresh tokens. No proxy.',
      flow: [
        ['Identity', 'Issue one durable subject to the Agent, independent of its host.'],
        ['Request', 'The Agent asks for a named resource, scope, and token lifetime.'],
        ['Approve', 'A controller grants only the authority the task actually needs.'],
        ['Access', 'The Agent calls the API directly with a short-lived DPoP token.'],
      ],
      distinctionEyebrow: 'Why Realmroot',
      distinctionTitle: ['Agent principals.', 'Authority is core.'],
      distinctionBody: 'Realmroot models an Agent as its own security principal while keeping a human or organization in control of every authority decision.',
      distinctions: [
        {
          number: '01',
          title: 'Identity survives the host.',
          body: 'The Agent keeps one issuer and subject while host keys rotate, move, or are revoked. A machine credential never becomes the public identity.',
          proof: 'Stable identity ≠ host credential',
        },
        {
          number: '02',
          title: 'Enrollment grants nothing.',
          body: 'Establishing identity does not imply business access. A new resource, account, or wider scope always requires a new controller decision.',
          proof: 'Identity first. Authority on request.',
        },
        {
          number: '03',
          title: 'Authority stays off the data path.',
          body: 'After approval, the Agent calls native or external APIs directly with a short-lived, audience-bound, DPoP-bound token.',
          proof: 'Agent → API, directly',
        },
      ],
      grantEyebrow: 'Explicit authority',
      grantTitle: ['One approval.', 'Fully explainable.'],
      grantBody: 'Every grant binds one Agent to one resource, exact scopes, and a clear lifetime. Audit records reconstruct who approved what without recording credentials or raw tokens.',
      ledger: {
        title: 'Access request',
        agent: 'Agent principal',
        controller: 'Controller',
        resource: 'Customer Support API',
        scopes: ['tickets:read', 'drafts:write'],
        lifetime: 'Limited · 30 min',
        approved: 'Controller approved',
        issued: 'Short-lived token issued',
      },
      realmEyebrow: 'One realm, every actor',
      realmTitle: ['Agent-first.', 'Not Agent-only.'],
      realmBody: 'People, applications, APIs, and Agents share one issuer and policy boundary. Your product stops stitching together a login system, an Agent key vault, and an authorization proxy.',
      realmActors: [
        ['People', 'Hosted sign-in, MFA, passkeys, sessions'],
        ['Applications', 'OIDC clients and product integrations'],
        ['Agents', 'Durable identity and delegated authority'],
        ['APIs', 'Native or external protected resources'],
      ],
      boundary: ['One deployment', 'One user pool', 'One issuer', 'One policy boundary'],
      standardsTitle: 'Open standards. No proprietary Agent tunnel.',
      standards: ['OpenID Connect', 'OAuth 2.0', 'RFC 8693', 'DPoP', 'OpenAPI'],
      productsEyebrow: 'Realmroot products',
      productsTitle: ['Identity for who acts.', 'A wallet for what they spend.'],
      productsBody: 'Use either product independently, or combine them into one trust chain for Agent identity, delegated access, and payments.',
      identityProduct: {
        label: '01 / Realmroot Identity',
        title: 'Durable identity. Explicit authority.',
        body: 'One issuer and policy boundary for people, applications, APIs, and Agents. Short-lived, DPoP-bound tokens let Agents call target APIs directly.',
        points: ['Durable Agent subjects', 'Exact scopes and lifetimes', 'Standard OIDC and OAuth'],
        cta: 'Read Identity docs',
      },
      walletProduct: {
        label: '02 / Realmroot Wallet',
        title: 'Give Agents a budget. Keep the keys.',
        body: 'An OIDC-native wallet SaaS for delegated x402 payments. Users keep control while each Agent acts inside an explicit, revocable spending policy.',
        points: ['Total, per-payment, daily, and monthly USDC limits', 'Merchant and recipient allowlists', 'Pause, revoke, and payment audit'],
        cta: 'Open Wallet',
      },
      blogEyebrow: 'Journal',
      blogTitle: ['Agent identity. Explicit authority.'],
      allPosts: 'View all writing',
      read: 'Read',
      finalTitle: ['Give your Agents a real identity.'],
      finalBody: 'Run one realm as the trust root for people, applications, APIs, and Agents.',
      deploy: 'Deploy Realmroot',
      walletCta: 'Open Wallet',
    };
---

<section class="hero section-shell" id="agents">
  <div class="hero-copy">
    <p class="eyebrow"><span></span>{t.eyebrow}</p>
    <h1><span>{t.title[0]}</span><span>{t.title[1]}</span></h1>
    <p class="hero-lead"><PhraseText locale={locale} text={t.lead} /></p>
    <div class="hero-actions">
      <a class="button button-primary" href="#authority">{t.primary}<span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href={docsHref}>{t.secondary}</a>
    </div>
    <div class="hero-facts" aria-label="Agent authority properties">
      {t.facts.map((fact) => <span>{fact}</span>)}
    </div>
  </div>

  <div class="agent-passport" aria-label="Durable Agent identity and authority request">
    <p class="passport-label">{t.passport.label}</p>
    <div class="passport-stage">
      <div class="host-stack">
        <strong>{t.passport.hosts}</strong>
        {t.passport.hostNames.map((host, index) => (
          <span><i class={`host-mark mark-${index + 1}`} aria-hidden="true"></i>{host}</span>
        ))}
      </div>
      <div class="identity-card">
        <div class="identity-card-head">
          <small>{t.passport.identity}</small>
          <i class="root-mark" aria-hidden="true"></i>
        </div>
        <h2>{t.passport.name}</h2>
        <dl>
          <dt>{t.passport.issuer}</dt>
          <dd>{t.passport.issuerValue}</dd>
          <dt>{t.passport.subject}</dt>
          <dd>{t.passport.subjectValue}</dd>
        </dl>
      </div>
      <div class="identity-proof"><i></i><span>{t.passport.verified}</span><b>VERIFIED</b></div>
      <div class="request-card">
        <div>
          <strong>{t.passport.request}</strong>
          <span>{t.passport.status}</span>
        </div>
        <dl>
          <div><dt>{t.passport.resource}</dt><dd>Knowledge API</dd></div>
          <div><dt>{t.passport.scope}</dt><dd>articles:read</dd></div>
          <div><dt>{t.passport.lifetime}</dt><dd>15 minutes</dd></div>
        </dl>
      </div>
    </div>
  </div>
</section>

<section class="authority-section" id="authority">
  <div class="section-shell">
    <div class="authority-heading">
      <h2 class="heading-lines">{t.authorityTitle.map((line) => <span>{line}</span>)}</h2>
      <p><PhraseText locale={locale} text={t.authorityNote} /></p>
    </div>
    <div class="authority-steps">
      {t.flow.map(([title, body], index) => (
        <article>
          <span>0{index + 1}</span>
          <h3>{title}</h3>
          <p><PhraseText locale={locale} text={body} /></p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="distinction-section section" id="product">
  <div class="section-shell">
    <div class="section-intro">
      <p class="eyebrow"><span></span>{t.distinctionEyebrow}</p>
      <h2 class="heading-lines">{t.distinctionTitle.map((line) => <span>{line}</span>)}</h2>
      <p><PhraseText locale={locale} text={t.distinctionBody} /></p>
    </div>
    <div class="distinction-grid">
      {t.distinctions.map((item) => (
        <article>
          <span>{item.number}</span>
          <h3>{item.title}</h3>
          <p><PhraseText locale={locale} text={item.body} /></p>
          <strong>{item.proof}</strong>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="grant-section section">
  <div class="section-shell grant-layout">
    <div class="grant-copy">
      <p class="eyebrow light"><span></span>{t.grantEyebrow}</p>
      <h2 class="heading-lines">{t.grantTitle.map((line) => <span>{line}</span>)}</h2>
      <p><PhraseText locale={locale} text={t.grantBody} /></p>
      <a class="text-link light-link" href={`${docsHref}concepts/agent-authority/`}>{zh ? '阅读 Agent 授权模型' : 'Read the Agent authority model'} →</a>
    </div>
    <div class="grant-ledger">
      <div class="ledger-head">
        <strong>{t.ledger.title}</strong>
        <span>GRANT ACTIVE</span>
      </div>
      <div class="principal-row">
        <div><small>{t.ledger.agent}</small><strong>Research Agent</strong></div>
        <span>≠</span>
        <div><small>{t.ledger.controller}</small><strong>Product operator</strong></div>
      </div>
      <dl class="grant-details">
        <div><dt>Resource</dt><dd>{t.ledger.resource}</dd></div>
        <div><dt>Scopes</dt><dd>{t.ledger.scopes.map((scope) => <code>{scope}</code>)}</dd></div>
        <div><dt>Lifetime</dt><dd><code>{t.ledger.lifetime}</code></dd></div>
      </dl>
      <div class="grant-status">
        <span>✓ {t.ledger.approved}</span>
        <span>→ {t.ledger.issued}</span>
      </div>
    </div>
  </div>
</section>

<section class="realm-section section" id="architecture">
  <div class="section-shell">
    <div class="realm-layout">
      <div class="realm-copy">
        <p class="eyebrow"><span></span>{t.realmEyebrow}</p>
        <h2 class="heading-lines">{t.realmTitle.map((line) => <span>{line}</span>)}</h2>
        <p><PhraseText locale={locale} text={t.realmBody} /></p>
        <div class="realm-boundary-facts">
          {t.boundary.map((item) => <span>{item}</span>)}
        </div>
      </div>
      <div class="actor-map">
          <div class="actor-root"><i class="root-mark" aria-hidden="true"></i><strong>Realmroot</strong><span>{zh ? '信任根' : 'Identity root'}</span></div>
        <div class="actor-grid">
          {t.realmActors.map(([actor, body]) => (
            <article>
              <span>{actor}</span>
              <p><PhraseText locale={locale} text={body} /></p>
            </article>
          ))}
        </div>
      </div>
    </div>
    <div class="standards-strip">
      <strong><PhraseText locale={locale} text={t.standardsTitle} /></strong>
      <div>{t.standards.map((standard) => <span>{standard}</span>)}</div>
    </div>
  </div>
</section>

<section class="product-suite" id="products">
  <div class="section-shell">
    <div class="product-suite-header">
      <div>
        <p class="eyebrow"><span></span>{t.productsEyebrow}</p>
        <h2 class="heading-lines">{t.productsTitle.map((line) => <span>{line}</span>)}</h2>
      </div>
      <p><PhraseText locale={locale} text={t.productsBody} /></p>
    </div>
    <div class="product-suite-grid">
      <article class="product-card identity-product">
        <span class="product-label">{t.identityProduct.label}</span>
        <h3>{t.identityProduct.title}</h3>
        <p><PhraseText locale={locale} text={t.identityProduct.body} /></p>
        <ul>
          {t.identityProduct.points.map((point) => <li><span></span>{point}</li>)}
        </ul>
        <a class="text-link" href={docsHref}>{t.identityProduct.cta} →</a>
      </article>
      <article class="product-card wallet-product">
        <div class="wallet-product-head">
          <span class="product-label">{t.walletProduct.label}</span>
          <span class="wallet-live"><i></i>OIDC · x402 · USDC</span>
        </div>
        <h3>{t.walletProduct.title}</h3>
        <p><PhraseText locale={locale} text={t.walletProduct.body} /></p>
        <div class="wallet-policy" aria-label="Example Agent Wallet spending policy">
          <div><span>Agent</span><strong>Research Agent</strong></div>
          <div><span>{zh ? '单笔上限' : 'Per payment'}</span><strong>10.00 USDC</strong></div>
          <div><span>{zh ? '月度预算' : 'Monthly budget'}</span><strong>100.00 USDC</strong></div>
          <div><span>{zh ? '状态' : 'Policy'}</span><strong class="policy-active">{zh ? '可撤销' : 'Revocable'}</strong></div>
        </div>
        <ul>
          {t.walletProduct.points.map((point) => <li><span></span>{point}</li>)}
        </ul>
        <a class="wallet-link" href={site.wallet}>{t.walletProduct.cta}<span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </div>
</section>

<section class="blog-preview">
  <div class="section-shell">
    <div class="blog-preview-header">
      <div>
        <p class="eyebrow"><span></span>{t.blogEyebrow}</p>
        <h2 class="heading-lines">{t.blogTitle.map((line) => <span>{line}</span>)}</h2>
      </div>
      <a class="text-link" href={zh ? '/zh-cn/blog/' : '/blog/'}>{t.allPosts} →</a>
    </div>
    <div class="post-grid">
      {posts.map((post) => {
        const slug = post.id.replace(/^(en|zh-cn)\//, '');
        const href = zh ? `/zh-cn/blog/${slug}/` : `/blog/${slug}/`;
        return (
          <a class="post-card" href={href}>
            <div class="meta">
              <span>{post.data.publishedAt.toLocaleDateString(locale)}</span>
              <span>{t.read} ↗</span>
            </div>
            <h3>{post.data.title}</h3>
            <p><PhraseText locale={locale} text={post.data.description} /></p>
          </a>
        );
      })}
    </div>
  </div>
</section>

<section class="final-cta">
  <div class="section-shell final-cta-inner">
    <div>
      <p class="eyebrow light"><span></span>One realm. Every actor. Explicit authority.</p>
      <h2 class="heading-lines">{t.finalTitle.map((line) => <span>{line}</span>)}</h2>
      <p><PhraseText locale={locale} text={t.finalBody} /></p>
    </div>
    <div class="final-actions">
      <a class="button button-inverted" href="https://github.com/realmroot/realmroot#deploy">{t.deploy}</a>
      <a class="button button-ghost-light" href={site.wallet}>{t.walletCta}</a>
    </div>
  </div>
</section>
