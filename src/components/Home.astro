---
import { getCollection } from 'astro:content';
import type { Locale } from '../site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isChinese = locale === 'zh-CN';
const posts = (await getCollection('blog'))
  .filter((post) => post.data.language === locale)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);

const t = isChinese
  ? {
      eyebrow: '面向产品的身份基础设施',
      headline: '一个 Realm，承载每一种行动者。',
      lead: '为用户、应用、API 与受委托 Agent 运行一个独立的身份根。统一认证、授权与显式委托，保持清晰的安全边界。',
      primary: '部署你的 Realm',
      secondary: '阅读架构文档',
      note: '开源 · 自托管 · 基于标准协议',
      trust: [
        ['边界', '一个部署，一个 Issuer'],
        ['集成', 'OIDC + OAuth 2.0'],
        ['运行时', 'Cloudflare Workers'],
        ['授权', '显式委托'],
      ],
      sectionEyebrow: '一个控制平面',
      sectionTitle: '身份不是外围插件，而是产品的信任根。',
      sectionLead: 'Realmroot 把重复的用户表、登录页、OAuth 客户端、策略与 Agent 授权整合为一个可部署的身份服务。',
      cards: [
        ['托管认证', '让每个产品应用通过标准 OIDC 接入同一个用户池，直接获得登录、注册、恢复与 OAuth 同意流程。', 'AUTH'],
        ['账户中心', '用户在统一入口管理资料、凭据、MFA、Passkey、会话、关联账户与授权应用。', 'USER'],
        ['管理 Console', '团队从一个控制面配置应用、用户、Connector、安全策略、角色、API 资源与品牌。', 'OPS'],
        ['资源 API', '所有管理能力都有清晰的资源接口与 OpenAPI 契约，适合自动化，也适合 Agent 操作。', 'API'],
      ],
      architectureEyebrow: '真实的安全边界',
      architectureTitle: '从产品到 Issuer，再到受保护资源。',
      architectureLead: '每个 Realmroot 部署拥有自己的用户池、Issuer、策略、数据库与密钥。需要隔离时，部署新的 Realm，而不是在共享表上追加例外。',
      nodes: [
        ['People · Apps · Agents', '行动者', '用户登录，应用发起 OIDC 流程，Agent 请求明确的资源权限。'],
        ['Realmroot', '身份与授权根', '一个用户池、一个 Issuer、一个 Console，以及统一的策略边界。'],
        ['APIs · Products', '受保护资源', '应用验证标准令牌；Agent 使用短期、受众受限且 DPoP 绑定的访问令牌。'],
      ],
      agentEyebrow: '为 Agent 设计，而不是后补',
      agentTitle: '稳定身份。受控主机。最小权限。',
      agentLead: 'Realmroot 将持久 Agent 身份与当前承载它的主机和密钥分离。每次资源访问都需要控制者批准，并绑定精确的资源、账户与 scope。',
      points: ['Enrollment 只建立身份，不自动授予权限', '权限扩张与资源变化必须重新批准', 'Agent 直接访问 API，Realmroot 不充当代理'],
      statement: 'Your product’s identity root.',
      statementLead: '为产品运行一个 Realm，让用户、应用、API 与 Agent 在同一套显式权威模型中协作。',
      blogTitle: '来自 Realmroot',
      allPosts: '查看全部文章',
      read: '阅读',
    }
  : {
      eyebrow: 'Identity infrastructure for products',
      headline: 'One realm. Every actor. Explicit authority.',
      lead: 'Run an identity root for users, applications, APIs, and delegated agents—with authentication, authorization, and delegation inside one clear boundary.',
      primary: 'Deploy your realm',
      secondary: 'Read the architecture',
      note: 'Open source · Self-hosted · Standards-based',
      trust: [
        ['Boundary', 'One deployment, one issuer'],
        ['Integration', 'OIDC + OAuth 2.0'],
        ['Runtime', 'Cloudflare Workers'],
        ['Authority', 'Explicit delegation'],
      ],
      sectionEyebrow: 'One control plane',
      sectionTitle: 'Identity is your trust root, not a login plugin.',
      sectionLead: 'Realmroot packages the user tables, hosted flows, OAuth clients, policy, and agent authority every product would otherwise rebuild.',
      cards: [
        ['Hosted auth', 'Connect product applications to one user pool through standard OIDC, with sign-in, sign-up, recovery, and OAuth consent included.', 'AUTH'],
        ['Account center', 'Give people one place to manage profiles, credentials, MFA, passkeys, sessions, linked accounts, and authorized apps.', 'USER'],
        ['Admin console', 'Operate applications, users, connectors, policy, roles, API resources, branding, and deployment readiness from one surface.', 'OPS'],
        ['Resource API', 'Every management capability has a resource-oriented interface and OpenAPI contract—built for automation and agents.', 'API'],
      ],
      architectureEyebrow: 'A real security boundary',
      architectureTitle: 'From product actor to issuer to protected resource.',
      architectureLead: 'Each Realmroot deployment owns its user pool, issuer, policy, database, and keys. When you need isolation, deploy another realm instead of adding exceptions to shared tables.',
      nodes: [
        ['People · Apps · Agents', 'Actors', 'People sign in, apps start OIDC flows, and agents ask for explicit resource authority.'],
        ['Realmroot', 'Identity root', 'One user pool, one issuer, one console, and one shared security-policy boundary.'],
        ['APIs · Products', 'Protected resources', 'Apps validate standard tokens. Agents use short-lived, audience-bound, DPoP-bound access.'],
      ],
      agentEyebrow: 'Agent-native, not bolted on',
      agentTitle: 'Stable identity. Controlled hosts. Least authority.',
      agentLead: 'Realmroot separates a durable agent identity from the host and key that currently presents it. Resource access requires controller approval and binds an exact resource, account, and scope set.',
      points: ['Enrollment establishes identity, never automatic authority', 'Scope expansion or resource changes require a new decision', 'Agents call protected APIs directly; Realmroot is not a proxy'],
      statement: 'Your product’s identity root.',
      statementLead: 'Run one realm so people, applications, APIs, and agents can work inside the same explicit model of authority.',
      blogTitle: 'From Realmroot',
      allPosts: 'View all writing',
      read: 'Read',
    };

---

<section class="section-shell hero">
  <div>
    <p class="eyebrow">{t.eyebrow}</p>
    <h1 set:html={t.headline.replace('Every actor', '<em>Every actor</em>').replace('每一种行动者', '<em>每一种行动者</em>')} />
    <p class="hero-lead">{t.lead}</p>
    <div class="hero-actions">
      <a class="button button-lime" href="https://github.com/realmroot/realmroot#deploy">{t.primary}</a>
      <a class="button button-ghost" href={isChinese ? '/zh-cn/docs/' : '/docs/'}>{t.secondary}</a>
    </div>
    <p class="hero-note"><span></span>{t.note}</p>
  </div>
  <div class="realm-visual" aria-label="One identity realm connecting people, applications, APIs, and agents">
    <div class="actor actor-human">People</div>
    <div class="actor actor-app">Apps</div>
    <div class="actor actor-api">APIs</div>
    <div class="actor actor-agent">Agents</div>
    <div class="realm-center">Identity<br />root</div>
  </div>
</section>

<section class="trust-strip" aria-label="Platform foundation">
  <div class="section-shell trust-inner">
    <div class="trust-item">
      <span>Realmroot</span>
      <strong>Identity + delegated access</strong>
    </div>
    {t.trust.map(([label, value]) => (
      <div class="trust-item">
        <span>{label}</span>
        <strong>{value}</strong>
      </div>
    ))}
  </div>
</section>

<section class="section" id="product">
  <div class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.sectionEyebrow}</p>
        <h2>{t.sectionTitle}</h2>
      </div>
      <p>{t.sectionLead}</p>
    </div>
    <div class="capability-grid">
      {t.cards.map(([title, description, glyph], index) => (
        <article class:list={['capability-card', index === 1 && 'dark', index === 2 && 'lime']}>
          <span class="card-number">0{index + 1}</span>
          <span class="card-glyph">{glyph}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section architecture" id="architecture">
  <div class="section-shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.architectureEyebrow}</p>
        <h2>{t.architectureTitle}</h2>
      </div>
      <p>{t.architectureLead}</p>
    </div>
    <div class="architecture-diagram">
      {t.nodes.map(([title, label, description], index) => (
        <>
          {index > 0 && <div class="flow-line" aria-hidden="true"></div>}
          <article class:list={['architecture-node', index === 1 && 'core']}>
            <span class="node-label">{label}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </article>
        </>
      ))}
    </div>
  </div>
</section>

<section class="section agent-section" id="agents">
  <div class="section-shell agent-layout">
    <div class="agent-copy">
      <p class="eyebrow">{t.agentEyebrow}</p>
      <h2>{t.agentTitle}</h2>
      <p>{t.agentLead}</p>
      <div class="agent-points">
        {t.points.map((point, index) => (
          <div class="agent-point">
            <span>0{index + 1}</span>
            <strong>{point}</strong>
          </div>
        ))}
      </div>
    </div>
    <div class="agent-terminal" aria-label="Example agent authorization flow">
      <div class="terminal-bar"><span></span><span></span><span></span></div>
      <pre class="terminal-content"><span class="prompt">$</span> realmroot agent enroll

<span class="dim">identity</span>  agent_01J...
<span class="dim">host</span>      codex-macbook
<span class="success">✓ Controller approved enrollment</span>

<span class="prompt">$</span> realmroot access request \
  --resource billing-api \
  --scope invoices:read

<span class="dim">authority</span> exact resource + scope
<span class="dim">token</span>     short-lived, DPoP-bound
<span class="success">✓ Grant approved · 30 minutes</span>

<span class="prompt">$</span> curl https://api.example.com/invoices
<span class="success">200 OK</span></pre>
    </div>
  </div>
</section>

<section class="section-shell statement">
  <h2>{t.statement}</h2>
  <p>{t.statementLead}</p>
  <a class="button button-dark" href="https://github.com/realmroot/realmroot">{t.primary}</a>
</section>

<section class="blog-preview">
  <div class="section-shell">
    <div class="blog-preview-header">
      <h2>{t.blogTitle}</h2>
      <a class="text-link" href={isChinese ? '/zh-cn/blog/' : '/blog/'}>{t.allPosts} →</a>
    </div>
    <div class="post-grid">
      {posts.map((post) => {
        const slug = post.id.replace(/^(en|zh-cn)\//, '');
        const href = isChinese ? `/zh-cn/blog/${slug}/` : `/blog/${slug}/`;
        return (
          <a class="post-card" href={href}>
            <div class="meta">
              <span>{post.data.publishedAt.toLocaleDateString(locale)}</span>
              <span>{t.read} ↗</span>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        );
      })}
    </div>
  </div>
</section>
