---
import { getCollection } from 'astro:content';
import type { Locale } from '../site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isChinese = locale === 'zh-CN';
const titleLines = isChinese
  ? ['让 Agent 行动。', '让授权有边界。']
  : ['Let agents act.', 'Every grant, explicit.'];
const posts = (await getCollection('blog'))
  .filter((post) => post.data.language === locale)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<section class="section-shell blog-hero">
  <p class="eyebrow"><span></span>{isChinese ? 'Agent 身份 · 授权 · 架构' : 'Agent identity · Authority · Architecture'}</p>
  <h1 class="heading-lines">{titleLines.map((line) => <span>{line}</span>)}</h1>
  <p>
    {isChinese
      ? '关于持久 Agent 身份、委托 API 访问与产品信任边界的实践。'
      : 'Field notes on durable Agent identity, delegated API access, and product trust boundaries.'}
  </p>
</section>

<section class="section-shell blog-index">
  <div class="post-grid">
    {posts.map((post) => {
      const slug = post.id.replace(/^(en|zh-cn)\//, '');
      const href = isChinese ? `/zh-cn/blog/${slug}/` : `/blog/${slug}/`;
      return (
        <a class="post-card" href={href}>
          <div class="meta">
            <span>{post.data.publishedAt.toLocaleDateString(locale)}</span>
            <span>{isChinese ? '阅读' : 'Read'} ↗</span>
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      );
    })}
  </div>
</section>
